#include <dt-bindings/led/led.h>
#include "keys60_rev_ansi62_rot-pinctrl.dtsi"
#include "keys60_rev_ansi62_rot-layouts.dtsi"

#include <dt-bindings/zmk/matrix_transform.h>

/ {
    model = "KEYS60_REV_ANSI62_ROT";
    compatible = "sig,keys60";

    chosen {
    	zmk,kscan = &kscan0;
        zmk,physical-layout = &layout_0;

        zmk,backlight = &backlight;
	zmk,underglow = &led_strip;
	
	zmk,battery = &vbatt;
	zmk,studio-rpc-uart = &cdc_acm_uart;
    };


    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
	columns = <7>;
	rows = <10>;
	map = <
	       RC(0,0) RC(1,0) RC(0,1) RC(1,1) RC(0,2) RC(1,2) RC(0,3) RC(1,3) RC(0,4) RC(1,4) RC(0,5) RC(1,5) RC(0,6) RC(1,6) RC(5,6)
	       RC(2,0)   RC(3,0) RC(2,1) RC(3,1) RC(2,2) RC(3,2) RC(2,3) RC(3,3) RC(2,4) RC(3,4) RC(2,5) RC(3,5) RC(2,6)   RC(3,6)
	       RC(4,0)     RC(5,0) RC(4,1) RC(5,1) RC(4,2) RC(5,2) RC(4,3) RC(5,3) RC(4,4) RC(5,4) RC(4,5) RC(5,5)          RC(4,6)
	       RC(6,0)       RC(7,0) RC(6,1) RC(7,1) RC(6,2) RC(7,2) RC(6,3) RC(7,3) RC(6,4) RC(7,4)  RC(6,5)          RC(7,5)  RC(6,6)
	       RC(8,0)   RC(9,0)   RC(8,1)                      RC(9,2)                     RC(9,4) RC(8,5) RC(9,5) RC(8,6) RC(9,6)
	       >;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
	diode-direction = "col2row";
        wakeup-source;

        col-gpios
	        = <&gpio1 9 GPIO_ACTIVE_HIGH>
		, <&gpio0 7 GPIO_ACTIVE_HIGH>
		, <&gpio0 29 GPIO_ACTIVE_HIGH>
		, <&gpio0 28 GPIO_ACTIVE_HIGH>
		, <&gpio0 2 GPIO_ACTIVE_HIGH>
		, <&gpio0 3 GPIO_ACTIVE_HIGH>
		, <&gpio1 15 GPIO_ACTIVE_HIGH>
		;

        row-gpios
	        = <&gpio0 23 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
		, <&gpio0 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
		, <&gpio0 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
		, <&gpio0 22 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
		, <&gpio1 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
		, <&gpio1 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
		, <&gpio1 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
		, <&gpio1 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
		, <&gpio1 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
		, <&gpio0 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
		;
    };
    
    vbatt: vbatt {
        compatible = "zmk,battery-voltage-divider";
	label = "VBATT";
	io-channels = <&adc 2>; // P0.04
	output-ohms = <2000000>;
	full-ohms = <(1000000 + 2000000)>;
	power-gpios = <&gpio0 5 GPIO_ACTIVE_HIGH>; // P0.05
    };
    
    ext-power {
        compatible = "zmk,ext-power-generic";
	label = "EXT_POWER";
	control-gpios = <&gpio0 12 GPIO_ACTIVE_HIGH>;
    };
    
    sensors {
        compatible = "zmk,keymap-sensors";
	sensors = <&encoder_1>;
	triggers-per-rotation = <10>;
    };
    
    encoder_1: encoder_1 {
        compatible = "alps,ec11";
	label = "ENCODER_ONE";
	a-gpios = <&gpio0 31 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;  /* swapped */
	b-gpios = <&gpio0 30 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;  /* swapped */
	steps = <24>;
	status = "okay";
    };
    
    backlight: pwmleds {
        compatible = "pwm-leds";
	label = "Backlight LEDs";
	pwm_led_0 {
	    pwms = <&pwm0 0 1000000 PWM_POLARITY_NORMAL>;
	};
    };
    
    leds {
        compatible = "gpio-leds";
	led_0: led_green { // P1.10
	    gpios = <&gpio1 10 GPIO_ACTIVE_LOW>;
	    label = "Green LED";
	    status = "okay";
	};
	led_1: led_red { // P1.13
	    gpios = <&gpio1 13 GPIO_ACTIVE_LOW>;
	    label = "Red LED";
	    status = "okay";
	};
	led_2: led_blue { // P1.11
	    gpios = <&gpio1 11 GPIO_ACTIVE_LOW>;
	    label = "Blue LED";
	    status = "okay";
	};
    };
    
    // These aliases are provided for compatibility with samples
    aliases {
        ledgreen = &led_0;
	ledred   = &led_1;
	ledblue  = &led_2;
    };

};

// for back-light
&pwm0 {
	status = "okay";
	pinctrl-0 = <&pwm0_default>;
	pinctrl-1 = <&pwm0_sleep>;
	pinctrl-names = "default", "sleep";
};

// for underglow
&spi3 {
	compatible = "nordic,nrf-spim";
	status = "okay";
	pinctrl-0 = <&spi3_default>;
	pinctrl-1 = <&spi3_sleep>;
	pinctrl-names = "default", "sleep";
	// rx-delay-supported;
	// rx-delay = < 0x2 >;
	led_strip: ws2812@0 {
		compatible = "worldsemi,ws2812-spi";
		label = "WS2812";

		/* SPI */
		reg = <0>; /* ignored, but necessary for SPI bindings */
		spi-max-frequency = <4000000>;

		/* WS2812 */
		chain-length = <17>; /* LED strip length */
		spi-one-frame = <0x70>;
		spi-zero-frame = <0x40>;
		color-mapping = <LED_COLOR_ID_GREEN LED_COLOR_ID_RED LED_COLOR_ID_BLUE>;
	};
};


&usbd {
    cdc_acm_uart: cdc_acm_uart {
        compatible = "zephyr,cdc-acm-uart";
    };
};
